#!/usr/bin/env python3
"""Tagnan's calls, the sounds he makes when he asks a question. Synthesized, as Dartt's are: no
sample, nothing to credit, the standard library only. Writes assets/sounds/<call>.wav for each
call; run it again after changing one (the window plays the files, it never runs this)."""

# ruff: noqa: S311 - seeded noise, so that every run writes the same sounds

import array
import math
import random
import wave
from collections import deque
from collections.abc import Callable
from pathlib import Path

RATE = 44100
OUT = Path(__file__).resolve().parent.parent / "assets" / "sounds"
# Loudest 400 ms, K-weighted as broadcast loudness is (ITU-R BS.1770): about as loud as one
# another, and loud enough to be heard across a room, never above -1 dBFS.
LOUDNESS = -16.0
PEAK = 10 ** (-1 / 20)
MOST_LIMITING = 10 ** (3 / 20)  # a bell's peaks may be tamed by 3 dB to be as loud as the rest

Samples = list[float]


def mix(length: float, *parts: tuple[float, Samples]) -> Samples:
    """(start in seconds, samples), laid over each other in `length` seconds."""
    out = [0.0] * int(RATE * length)
    for start, samples in parts:
        offset = int(RATE * start)
        for i, value in enumerate(samples[: len(out) - offset]):
            out[offset + i] += value
    return out


# --- Bugle: a brass call -------------------------------------------------------------------


def brass(freq: float, seconds: float, vibrato: float = 0.0) -> Samples:
    """A lip-buzzed note: it scoops up to pitch and its high harmonics come in as it gets
    loud, which is most of what makes brass sound like brass."""
    harmonics = [h for h in range(1, 18) if h * freq < 9000]
    # A bugle is mellower than a trumpet: its harmonics fade above 3 kHz.
    mellow = [h**-0.7 / (1 + (h * freq / 3000) ** 2) for h in harmonics]
    out = []
    phase = 0.0
    for i in range(int(RATE * seconds)):
        t = i / RATE
        env = (1 - math.exp(-t / 0.009)) * (1 + 0.18 * math.exp(-t / 0.05))
        env *= min(1.0, (seconds - t) / 0.035)
        swell = min(1.0, max(0.0, (t - 0.16) / 0.2))
        freq_now = freq * (1 - 0.035 * math.exp(-t / 0.014))
        freq_now *= 1 + vibrato * swell * math.sin(2 * math.pi * 5.3 * t)
        phase += 2 * math.pi * freq_now / RATE
        bright = min(1.0, env)
        out.append(
            env
            * sum(
                bright ** (0.55 * (h - 1)) * mellow[k] * math.sin(h * phase)
                for k, h in enumerate(harmonics)
            )
        )
    return out


def bugle() -> Samples:
    """The cavalry's "Charge!" on a natural bugle in C: G C E G, E G."""
    c3 = 130.8128
    g4, c5, e5, g5 = 3 * c3, 4 * c3, 5 * c3, 6 * c3  # harmonics: its E is a little flat
    notes = [
        (0.00, g4, 0.10),
        (0.12, c5, 0.10),
        (0.24, e5, 0.10),
        (0.36, g5, 0.21),
        (0.60, e5, 0.10),
        (0.72, g5, 0.62),
    ]
    dry = mix(
        1.4, *((start, brass(f, d, vibrato=0.006 if d > 0.5 else 0.0)) for start, f, d in notes)
    )
    return reverb(dry, wet=0.2, tail=0.45)


# --- Clashing rapiers ----------------------------------------------------------------------

STEEL = [  # a blade's ringing modes: (frequency ratio, amplitude, decay per second)
    (1.0, 0.45, 3.5),
    (1.52, 1.0, 4.5),
    (2.21, 0.85, 6.0),
    (2.83, 0.6, 7.5),
    (3.64, 0.55, 9.0),
    (4.47, 0.4, 12.0),
    (5.39, 0.3, 15.0),
]


def clash(f0: float, strength: float, ring: float, rng: random.Random) -> Samples:
    """Steel on steel: a bright crack, a dull knock, then the blades ring, each mode a pair of
    close frequencies that beat (the shimmer of a long thin blade)."""
    seconds = 0.25 + 1.6 * ring
    out = []
    last = 0.0
    for i in range(int(RATE * seconds)):
        t = i / RATE
        noise = rng.uniform(-1, 1)
        crack = (noise - last) * math.exp(-t / 0.0018) * 0.9  # differenced: bright
        last = noise
        knock = math.sin(2 * math.pi * 870 * t) * math.exp(-t / 0.007) * 0.5
        modes = 0.0
        for ratio, amp, decay in STEEL:
            f = f0 * ratio
            fade = math.exp(-t * decay / ring)
            modes += (
                amp
                * fade
                * (
                    math.sin(2 * math.pi * f * t)
                    + 0.6 * math.sin(2 * math.pi * f * 1.0021 * t + 1.3)
                )
            )
        out.append(strength * (crack + knock + 0.42 * modes * min(1.0, t / 0.0007)))
    return out


def scrape(seconds: float, rng: random.Random) -> Samples:
    """A blade sliding along the other before the last blow: noise through a narrow band that
    rises from 2 to 6.5 kHz."""
    out = []
    y1 = y2 = x1 = x2 = 0.0
    n = int(RATE * seconds)
    for i in range(n):
        share = i / n
        centre = 2200 * (6500 / 2200) ** share
        w = 2 * math.pi * centre / RATE
        alpha = math.sin(w) / (2 * 7.0)
        a0 = 1 + alpha
        x = rng.uniform(-1, 1)
        y = (alpha * x - alpha * x2 - (-2 * math.cos(w)) * y1 - (1 - alpha) * y2) / a0
        x2, x1, y2, y1 = x1, x, y1, y
        out.append(y * (share**1.5) * 2.2)
    return out


def rapier() -> Samples:
    """Two quick parries, the blades slide, and the final blow rings: clang-clang, shiiing!"""
    rng = random.Random(1625)
    dry = mix(
        1.75,
        (0.00, clash(1180, 1.0, 0.55, rng)),
        (0.16, clash(1090, 0.72, 0.45, rng)),
        (0.30, scrape(0.14, rng)),
        (0.44, clash(1260, 1.0, 0.8, rng)),
    )
    return reverb(dry, wet=0.16, tail=0.3)


# --- Bell ----------------------------------------------------------------------------------

# Jean-Claude Risset's bell (Dodge and Jerse, Computer Music): (frequency ratio, offset in Hz,
# amplitude, share of the length it rings for). The close pairs beat, as a real bell's do.
RISSET = [
    (0.56, 0.0, 1.0, 1.0),
    (0.56, 1.0, 0.67, 0.9),
    (0.92, 0.0, 1.0, 0.65),
    (0.92, 1.7, 1.8, 0.55),
    (1.19, 0.0, 2.67, 0.325),
    (1.7, 0.0, 1.67, 0.35),
    (2.0, 0.0, 1.46, 0.25),
    (2.74, 0.0, 1.33, 0.2),
    (3.0, 0.0, 1.33, 0.15),
    (3.76, 0.0, 1.0, 0.1),
    (4.07, 0.0, 1.33, 0.075),
]


def strike(freq: float, seconds: float, rng: random.Random) -> Samples:
    """Its partials start at phases of their own, as a struck bell's do: no sharp peak where
    they would all add up at once."""
    phases = [rng.uniform(0, 2 * math.pi) for _ in RISSET]
    out = []
    for i in range(int(RATE * seconds)):
        t = i / RATE
        value = 0.0
        for (ratio, offset, amp, share), phase in zip(RISSET, phases, strict=True):
            fade = math.exp(-6.9 * t / (share * seconds))
            value += amp * fade * math.sin(2 * math.pi * (freq * ratio + offset) * t + phase)
        out.append(value * min(1.0, t / 0.0015))
    return out


def bell() -> Samples:
    """Ding, dong: a bell struck twice, the second a fourth lower."""
    rng = random.Random(1661)
    dry = mix(2.1, (0.0, strike(880.0, 1.6, rng)), (0.42, strike(659.26, 1.6, rng)))
    return reverb(dry, wet=0.1, tail=0.2)


# --- Lute ----------------------------------------------------------------------------------


def pluck(freq: float, seconds: float, t60: float, rng: random.Random) -> Samples:
    """A gut string, plucked (Karplus-Strong): noise circling a delay line that averages
    itself into a tone. An all-pass filter takes the delay's fractional sample, so the strings
    are in tune with each other."""
    period = RATE / freq
    n = int(period - 0.5)
    frac = period - 0.5 - n
    if frac < 0.1:
        n, frac = n - 1, frac + 1
    c = (1 - frac) / (1 + frac)
    rho = min(0.99995, 10 ** (-3 / (t60 * freq)) / math.cos(math.pi * freq / RATE))
    # The pluck: noise, softened for gut, then combed as if plucked a fifth along the string.
    noise, low = [], 0.0
    for _ in range(n):
        low += 0.35 * (rng.uniform(-1, 1) - low)
        noise.append(low)
    at = max(1, round(n / 5))
    line = [noise[i] - (noise[i - at] if i >= at else 0.0) for i in range(n)]
    out = []
    index = 0
    previous = ap_in = ap_out = 0.0
    for _ in range(int(RATE * seconds)):
        x = line[index]
        averaged = rho * 0.5 * (x + previous)
        previous = x
        y = c * averaged + ap_in - c * ap_out
        ap_in, ap_out = averaged, y
        line[index] = y
        index = (index + 1) % n
        out.append(x)
    return out


def lute() -> Samples:
    """A chord of D strummed upwards, then a rising A, D: a musician's call."""
    rng = random.Random(1844)
    chord = [(146.83 * 2, 2.2), (440.0, 1.9), (587.33, 1.7), (739.99, 1.5), (880.0, 1.4)]
    parts = [(0.03 * k, pluck(f, 1.6, t60, rng)) for k, (f, t60) in enumerate(chord)]
    parts += [(0.42, pluck(880.0, 1.2, 1.2, rng)), (0.56, pluck(1174.66, 1.2, 1.1, rng))]
    return reverb(mix(1.8, *parts), wet=0.16, tail=0.3)


# --- Kalimba -------------------------------------------------------------------------------

WOOD = [(1.0, 1.0, 9.0), (3.93, 0.22, 35.0), (9.2, 0.05, 80.0)]  # Dartt's woody notes


def tine(freq: float, seconds: float) -> Samples:
    out = []
    for i in range(int(RATE * seconds)):
        t = i / RATE
        value = sum(a * math.exp(-d * t) * math.sin(2 * math.pi * freq * r * t) for r, a, d in WOOD)
        out.append(value * min(1.0, t / 0.004))
    return out


def kalimba() -> Samples:
    """Three soft woody notes, G E C, the last an octave up: the quiet one."""
    dry = mix(1.3, (0.0, tine(783.99, 0.5)), (0.13, tine(659.26, 0.5)), (0.26, tine(1046.5, 0.9)))
    return reverb(dry, wet=0.1, tail=0.2)


# --- Room, loudness, file ------------------------------------------------------------------


def reverb(dry: Samples, wet: float, tail: float) -> Samples:
    """A small room (Freeverb's tunings: four damped combs, two all-passes), so that the
    synthesized notes do not sound as if played in a box."""
    signal = dry + [0.0] * int(RATE * tail)
    combs = [1557, 1617, 1491, 1422]
    room = [0.0] * len(signal)
    for delay in combs:
        line = [0.0] * delay
        index, store = 0, 0.0
        for i, x in enumerate(signal):
            y = line[index]
            store = y * 0.7 + store * 0.3
            line[index] = x + store * 0.78
            index = (index + 1) % delay
            room[i] += y / len(combs)
    for delay in (556, 225):
        line = [0.0] * delay
        index = 0
        for i, x in enumerate(room):
            held = line[index]
            room[i] = held - x
            line[index] = x + held * 0.5
            index = (index + 1) % delay
    return [x + wet * r for x, r in zip(signal, room, strict=True)]


def biquad(x: Samples, b: tuple[float, float, float], a: tuple[float, float]) -> Samples:
    out = []
    x1 = x2 = y1 = y2 = 0.0
    for v in x:
        y = b[0] * v + b[1] * x1 + b[2] * x2 - a[0] * y1 - a[1] * y2
        x2, x1, y2, y1 = x1, v, y1, y
        out.append(y)
    return out


def k_weighted(x: Samples) -> Samples:
    """BS.1770's two stages at our rate: a shelf for the head, a high-pass."""
    k = math.tan(math.pi * 1681.974450955533 / RATE)
    q = 0.7071752369554196
    vh = 10 ** (3.999843853973347 / 20)
    vb = vh**0.4996667741545416
    a0 = 1 + k / q + k * k
    shelf = biquad(
        x,
        ((vh + vb * k / q + k * k) / a0, 2 * (k * k - vh) / a0, (vh - vb * k / q + k * k) / a0),
        (2 * (k * k - 1) / a0, (1 - k / q + k * k) / a0),
    )
    k = math.tan(math.pi * 38.13547087602444 / RATE)
    q = 0.5003270373238773
    a0 = 1 + k / q + k * k
    return biquad(shelf, (1.0, -2.0, 1.0), (2 * (k * k - 1) / a0, (1 - k / q + k * k) / a0))


def loudness(x: Samples) -> float:
    """The loudest 400 ms, in LUFS."""
    weighted = [v * v for v in k_weighted(x)]
    window, hop = int(RATE * 0.4), int(RATE * 0.1)
    best = max(
        sum(weighted[start : start + window]) / window
        for start in range(0, max(1, len(weighted) - window + 1), hop)
    )
    return -0.691 + 10 * math.log10(best or 1e-12)


def finish(samples: Samples) -> Samples:
    """Without DC, its silent end cut, faded in and out (no click), at the loudness wanted."""
    clean, previous_in, previous_out = [], 0.0, 0.0
    for v in samples:  # one-pole high-pass at 20 Hz
        previous_out = 0.99715 * (previous_out + v - previous_in)
        previous_in = v
        clean.append(previous_out)
    top = max(abs(v) for v in clean)
    end = max(i for i, v in enumerate(clean) if abs(v) > top * 0.001) + 1
    clean = clean[:end]
    fade_in, fade_out = int(RATE * 0.002), int(RATE * 0.04)
    clean = [
        v * min(1.0, i / fade_in) * min(1.0, (len(clean) - i) / fade_out)
        for i, v in enumerate(clean)
    ]
    gain = 10 ** ((LOUDNESS - loudness(clean)) / 20)
    gain = min(gain, MOST_LIMITING * PEAK / max(abs(v) for v in clean))
    return limit([v * gain for v in clean], PEAK)


def limit(x: Samples, ceiling: float) -> Samples:
    """A look-ahead limiter: the gain dips smoothly around each peak above the ceiling and
    nowhere else. Each sample takes the lowest gain needed within 5 ms of it, averaged over
    those 10 ms: never more than a peak needs, never a step."""
    span = int(RATE * 0.005)
    need = [min(1.0, ceiling / abs(v)) if v else 1.0 for v in x]
    held: Samples = []
    window: deque[int] = deque()  # indices of rising needs: the lowest first
    for i in range(len(need) + span):
        if i < len(need):
            while window and need[window[-1]] >= need[i]:
                window.pop()
            window.append(i)
        while window[0] < i - 2 * span:
            window.popleft()
        if i >= span:
            held.append(need[window[0]])
    total, sums = 0.0, [0.0]
    for g in held:
        total += g
        sums.append(total)
    smooth = []
    for i in range(len(held)):
        low, high = max(0, i - span), min(len(held), i + span + 1)
        smooth.append((sums[high] - sums[low]) / (high - low))
    return [v * g for v, g in zip(x, smooth, strict=True)]


def save(samples: Samples, path: Path) -> None:
    data = array.array("h", (round(32767 * max(-1.0, min(1.0, v))) for v in samples))
    with wave.open(str(path), "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(RATE)
        out.writeframes(data.tobytes())


# The keys are those of tagnan/ui/sounds.py.
CALLS: dict[str, Callable[[], Samples]] = {
    "bugle": bugle,
    "rapier": rapier,
    "bell": bell,
    "lute": lute,
    "kalimba": kalimba,
}

if __name__ == "__main__":
    OUT.mkdir(parents=True, exist_ok=True)
    for name, make in CALLS.items():
        samples = finish(make())
        save(samples, OUT / f"{name}.wav")
        peak = 20 * math.log10(max(abs(v) for v in samples))
        print(
            f"{OUT / name}.wav  {len(samples) / RATE:.2f} s  {loudness(samples):.1f} LUFS"
            f"  peak {peak:.1f} dBFS"
        )
