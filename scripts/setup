#!/usr/bin/env bash
# Tagnan's guided setup, the one command after git clone: checks WSL (or macOS), installs uv if
# needed, then hands over to tagnan/setup.py (Claude Code and its login, the window's side, the
# settings, a real try of the brain, the shortcuts) and starts Tagnan. Safe to run again.
#   scripts/setup [--yes | --check]
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$(uname -s)" == Darwin ]]; then
  : # macOS: the window, the brain and the game side by side, nothing else to check here
elif [[ -z "${WSL_DISTRO_NAME:-}" ]] || ! command -v wslpath >/dev/null; then
  echo "Tagnan is set up from WSL or macOS: on Windows, open an Ubuntu terminal and run" >&2
  echo "scripts/setup from there (install WSL with \"wsl --install\" in PowerShell)." >&2
  exit 1
elif ! (cd /mnt/c && cmd.exe /c ver) >/dev/null 2>&1; then
  echo "WSL cannot start Windows programs ([interop] enabled=false in /etc/wsl.conf?)." >&2
  echo "Tagnan's window needs it: turn it back on, run \"wsl --shutdown\", then try again." >&2
  exit 1
fi

export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
if ! command -v uv >/dev/null; then
  installer="curl -LsSf https://astral.sh/uv/install.sh | sh"
  if [[ " $* " == *" --check "* ]]; then
    echo "✗ uv is missing: scripts/setup installs it." >&2
    exit 1
  fi
  echo "Tagnan needs uv, which provides his Python 3.12."
  answer=""
  if [[ " $* " != *" --yes "* ]]; then
    read -r -p "  Install it ($installer)? [Y/n]: " answer || true
  fi
  if [[ "$answer" == [nN]* ]]; then  # not ${answer,,}: macOS has bash 3.2
    echo "Nothing to do without uv: run scripts/setup again whenever you like." >&2
    exit 1
  fi
  curl -LsSf https://astral.sh/uv/install.sh | sh
  echo
fi

cd "$repo"
# Standard library only, like the brain: a bare Python 3.12 that uv fetches if needed.
exec uv run --quiet --no-project --python 3.12 python -B -m tagnan.setup "$@"
