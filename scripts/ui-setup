#!/usr/bin/env bash
# Create the window's Windows environment (%LOCALAPPDATA%\tagnan\venv), on Windows' Python 3.12
# or, without one, on a Python that uv brings for Tagnan only, and install its pinned, hashed
# dependencies (tagnan/ui/requirements.txt). Run it once, and after a version change.
# On macOS: the environment is ~/Library/Application Support/tagnan/venv, on uv's Python 3.12
# (the pinned wheels' hashes cover macOS too).
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo/scripts/_mac.sh"

if is_mac; then
  export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
  venv_dir="$(mac_state_dir)/venv"
  if [[ ! -x "$venv_dir/bin/python" ]]; then
    echo "Creating the window's environment in $venv_dir"
    uv venv --quiet --python 3.12 "$venv_dir"
  fi
  echo "Installing its dependencies (versions and hashes checked)…"
  uv pip install --quiet --python "$venv_dir/bin/python" --require-hashes --no-deps \
    -r "$repo/tagnan/ui/requirements.txt"
  echo "The window's environment is ready. Start Tagnan with scripts/tagnan."
  exit 0
fi

source "$repo/scripts/_windows.sh"
export PATH="$HOME/.local/bin:$PATH"  # uv, which unpacks uv for Windows

base="$(windows_base_python)"
venv_dir="$(windows_venv_dir)"
venv="$(wslpath -w "$venv_dir")"
requirements="$(wslpath -w "$repo/tagnan/ui/requirements.txt")"
cd /mnt/c
if [[ ! -x "$venv_dir/Scripts/python.exe" ]]; then
  echo "Creating the Windows environment in $venv"
  if [[ -x "$base" ]]; then
    "$base" -m venv "$venv"
  else
    # No Python on Windows: uv brings one, for Tagnan only, next to his other files.
    uv_exe="$(windows_uv)"
    UV_PYTHON_INSTALL_DIR="$(windows_localappdata)\\tagnan\\python" \
      WSLENV="UV_PYTHON_INSTALL_DIR:${WSLENV:-}" \
      "$uv_exe" venv --quiet --managed-python --python 3.12 "$venv"
  fi
fi
echo "Installing the dependencies (versions and hashes checked)…"
if [[ -x "$venv_dir/Scripts/pip.exe" ]]; then
  "$venv_dir/Scripts/python.exe" -m pip install --quiet --disable-pip-version-check \
    --require-hashes --no-deps -r "$requirements"
else  # an environment made by uv has no pip
  "$(windows_uv)" pip install --quiet --python "$venv\\Scripts\\python.exe" --require-hashes \
    --no-deps -r "$requirements"
fi
echo "Windows environment ready. Start Tagnan with scripts/tagnan."
